js_import og from /etc/nginx/njs/og-handler.js;
# Public origin of the site (scheme+host[+port]); prefixes every og:url and og:image.
js_var $og_origin "${PUBLIC_ORIGIN}";

server {
    listen 80;
    root /usr/share/nginx/html;

    location = /healthz {
        proxy_pass ${BACKEND_URL}/healthz;
        proxy_connect_timeout 5s;
        proxy_read_timeout 5s;
    }

    # Job event stream (WebSocket): needs HTTP/1.1 upgrade and a longer idle timeout (server pings every <= 30 s).
    location ~ ^/api/v1/jobs/[^/]+/events$ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
    }

    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_connect_timeout 5s;
        proxy_read_timeout 5s;
    }

    location /og/ {
        add_header Cache-Control "public, max-age=86400";
    }

    # HTML routes: index.html with the link-preview card injected (nginx/og.js); assets are served as files.
    location = / {
        js_content og.html;
    }

    location = /index.html {
        js_content og.html;
    }

    location / {
        try_files $uri @spa;
    }

    location @spa {
        js_content og.html;
    }

    # Only used when the handler itself fails: the plain SPA shell.
    location @plain {
        try_files /index.html =404;
        add_header Cache-Control no-cache;
    }
}
